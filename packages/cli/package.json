{
	"name": "beakcrypt",
	"version": "0.0.1",
	"description": "Secure environment variable management with E2E encryption",
	"type": "module",
	"bin": {
		"beakcrypt": "./dist/index.js"
	},
	"files": ["dist"],
	"publishConfig": {
		"access": "public"
	},
	"private": false,
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"typecheck": "tsgo --pretty --noEmit",
		"lint": "eslint",
		"format": "prettier --write ."
	},
	"dependencies": {
		"@beakcrypt/convex": "workspace:*",
		"@beakcrypt/crypto": "workspace:*",
		"@beakcrypt/shared": "workspace:*",
		"commander": "^13.1.0",
		"convex": "^1.32.0",
		"dotenv": "^16.5.0",
		"open": "^10.2.0",
		"ora": "^8.2.0",
		"picocolors": "^1.1.1",
		"prompts": "^2.4.2"
	},
	"devDependencies": {
		"@beakcrypt/eslint-config": "workspace:*",
		"@beakcrypt/typescript-config": "workspace:*",
		"@types/node": "^25.3.2",
		"@types/prompts": "^2.4.9",
		"@typescript/native-preview": "7.0.0-dev.20260228.1",
		"eslint": "^10.0.2",
		"prettier": "^3.8.1",
		"tsup": "^8.5.0"
	}
}
