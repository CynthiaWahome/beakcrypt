# ============================================================
# Beakcrypt — Web App Environment Variables
# ============================================================
# Copy this file to .env.local and fill in the values:
#
#   cp apps/web/.env.example apps/web/.env.local
#
# Never commit .env.local — it is already in .gitignore.
# ============================================================


# ------------------------------------------------------------
# App
# ------------------------------------------------------------
# Options: local | test | development | staging | production

NODE_ENV=local
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# ------------------------------------------------------------
# Convex (Database + Backend)
# ------------------------------------------------------------
# 1. From the repo root, run: npx convex dev
#    (No global install needed — npx handles it.)
# 2. This creates a free deployment and prints these values.
# Docs: https://docs.convex.dev

CONVEX_DEPLOYMENT=
CONVEX_URL=
CONVEX_SITE_URL=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=


# ------------------------------------------------------------
# Authentication — Better Auth
# ------------------------------------------------------------
# Generate a secret:  openssl rand -base64 32
# Docs: https://www.better-auth.com

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000


# ------------------------------------------------------------
# OAuth — GitHub
# ------------------------------------------------------------
# Create an OAuth App at: https://github.com/settings/developers
# Homepage URL:      http://localhost:3000
# Callback URL:      http://localhost:3000/api/auth/callback/github

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
