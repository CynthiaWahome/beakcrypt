{
  "$schema": "https://turborepo.dev/microfrontends/schema.json",
  "applications": {
    "@beakcrypt/web": {
      "development": {
        "local": {
          "port": 3000
        },
        "fallback": "beakcrypt.com"
      }
    },
    "@beakcrypt/docs": {
      "development": {
        "local": {
          "port": 3001
        }
      },
      "routing": [
        {
          "paths": [
            "/docs",
            "/docs/:path*"
          ]
        }
      ]
    }
  }
}